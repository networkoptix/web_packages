      {
        "name": "support",
        "old_name": "Support",
        "label": "Support",
        "description": "Support information for the integration that appear on the rightmost column of the integration's page.",
        "translatable": false,
        "values": [
          {
            "name": "hideEmail",
            "label": "Hide email",
            "value": false,
            "description": "Hides the support email from the frontend",
            "type": "check_box",
            "optional": true,
            "advanced": true
          },
          {
            "name": "supportEmail",
            "label": "Support E-mail",
            "value": "",
            "description": "E-mail customers should use for support.",
            "placeholder": "support@example.com",
            "type": "text",
            "optional": false,
            "meta": {
              "regex": "^[a-zA-Z0-9\\.!#$%&’*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$"
            }
          },
          {
            "name": "supportPhone",
            "label": "Support phone",
            "value": "",
            "description": "Phone number customers should use for support. (Ex. (573) 884-1878 | +1 (573) 884-1878 | +(591) 7433433 | 0591 74339296 | +1 555 555 5554)",
            "placeholder": "+1 800 800 8000",
            "type": "text",
            "optional": true,
            "meta": {
              "regex": "^(([+]?[(]?[0-9]{1,3}[)]?)|([(]?[0-9]{4}[)]?))\\s*[)]?[-\\s\\.]?[(]?[0-9]{1,3}[)]?([-\\s\\.]?[0-9]{3})([-\\s\\.]?[0-9]{3,4})$"
            }
          },
          {
            "name": "supportWeb",
            "label": "Support URL",
            "value": "",
            "description": "Web address customers should use for support. Example: http://support.google.com, https://www.yahoo.com/support",
            "placeholder": "https://support.google.com",
            "type": "text",
            "optional": true,
            "meta": {
              "regex": "^https?:\\/\\/([\\da-z\\.~_-]+)\\.([a-z\\.]{2,6})([\\/\\w ~\\.#-]*)*\\/?$"
            }
