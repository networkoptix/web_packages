{
    "affected": {
        "defaultBase": "develop"
    },
    "tasksRunnerOptions": {
        "default": {
            "runner": "nx/tasks-runners/default",
            "options": {
                "cacheableOperations": ["build", "lint", "test"]
            }
        }
    },
    "targetDefaults": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "default",
                "production",
                "^production",
                "{workspaceRoot}/tsconfig*.json",
                "{projectRoot}/tsconfig*.json"
            ],
            "options": {
                "outputPath": "dist/{projectName}"
            }
        },
        "test": {
            "executor": "@nx/jest:jest",
            "options": {
                "jestConfig": "{projectRoot}/jest.config.ts",
                "passWithNoTests": true
            },
            "configurations": {
                "watch": {
                    "watch": true
                },
                "ci": {
                    "ci": true,
                    "codeCoverage": true
                }
            },
            "inputs": [
                "default",
                "^production",
                "{workspaceRoot}/jest.preset.js",
                "{workspaceRoot}/test_utils/**",
                "{workspaceRoot}/tsconfig*.json",
                "{projectRoot}/tsconfig*.json"
            ],
            "outputs": [
                "{workspaceRoot}/junit/{projectName}/**",
                "{workspaceRoot}/coverage/{projectName}/**"
            ]
        },
        "lint": {
            "executor": "@nrwl/linter:eslint",
            "options": {
                "eslintConfig": "./.eslintrc.js",
                "lintFilePatterns": [
                    "{projectRoot}/**/*.ts",
                    "{projectRoot}/**/*.component.html"
                ]
            },
            "inputs": [
                "default",
                "{workspaceRoot}/eslint-plugin-nx/**",
                "{workspaceRoot}/.eslintrc.js",
                "{workspaceRoot}/.eslintignore",
                "{workspaceRoot}/tsconfig*.json",
                "{projectRoot}/tsconfig*.json"
            ],
            "outputs": [
                "{projectRoot}"
            ]
        }
    },
    "workspaceLayout": {
        "appsDir": "apps",
        "libsDir": "libs"
    },
    "cli": {
        "analytics": "a9b206ea-be72-4bd1-8b99-710455b85aea",
        "cache": {
            "enabled": true,
            "path": ".angular/cache",
            "environment": "all"
        }
    },
    "generators": {
        "@angular-eslint/schematics:application": {
            "setParserOptionsProject": true
        },
        "@angular-eslint/schematics:library": {
            "setParserOptionsProject": true
        },
        "@nx/angular:application": {
            "style": "css",
            "linter": "eslint",
            "unitTestRunner": "jest",
            "e2eTestRunner": "none"
        },
        "@nx/angular:library": {
            "linter": "eslint",
            "unitTestRunner": "jest"
        },
        "@nx/angular:component": {
            "style": "css"
        }
    },
    "namedInputs": {
        "default": [
            "{projectRoot}/**/*"
        ],
        "sharedGlobals": [
            "{workspaceRoot}/common/**/*"
        ],
        "production": [
            "default",
            "sharedGlobals",
            "!{projectRoot}/**/*.spec.[jt]s",
            "!{projectRoot}/tsconfig.spec.json",
            "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
            "!{projectRoot}/jest.config.[jt]s",
            "!{projectRoot}/src/test-setup.[jt]s"
        ]
    }
}