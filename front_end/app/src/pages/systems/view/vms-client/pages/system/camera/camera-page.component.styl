:host
  width 100%
  display flex
  flex-direction column
  position relative
  height calc(100vh - 50px)

  > header
    background #000
    height 40px
    position absolute
    top 0
    left 0
    right 0
    font-size 20px
    line-height 40px
    color white
    padding 0 1em
    z-index 10

    > span
      display inline-block
      padding-right 1em

  > player,
  > .no-player-message
    flex-grow 1
    background-color black

  > .no-player-message
    flex-grow 1
    color white
    display flex
    flex-direction: row;
    justify-content: center;
    align-items: center;
    text-transform: uppercase;

  > .controls
    flex-grow 0
    flex-shrink 0
    height 100px
    display flex
    flex-direction row
    overflow-y hidden

    > playback-controls
      flex-grow 0
      flex-shrink 0

    > zoom-controls {
      flex-grow: 0;
      flex-shrink: 0;
    }

    > timeline {
      flex-grow: 1;
      border-left: 1px solid $border-color;
      border-right: 1px solid $border-color;
    }

    > .no-archive-message {
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-transform: uppercase;
      font-size: 3rem;
      border-left: 1px solid $border-color;
      border-right: 1px solid $border-color;
    }

    > playback-state-indicator
      flex-grow 0
      flex-shrink 0
      width 54px

