:host
  display inline-block
  background-color #f0f3f4
  width 63px
  overflow hidden
  position relative
  > .button
    opacity 0.0
    display block
    // height 33%
    border-top 1px solid #cdd7dc
    border-bottom 1px solid #cdd7dc
    text-align center

    position absolute
    left 0
    top 0
    bottom 0
    right 0

    display flex
    flex-direction column
    justify-content center
    align-items center

    &.enabled
      cursor pointer
      opacity 1.0
      z-index 10

      &:hover
        background-color #cdd7dc
        color #f0f3f4
