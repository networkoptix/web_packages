:host
  display inline-block
  background-color #f0f3f4
  width 63px
  overflow hidden
  position relative
  > .button
    opacity 0.0
    display block
    // height 33%
    border-top 1px solid #cdd7dc
    border-bottom 1px solid #cdd7dc
    text-align center

    position absolute
    left 0
    top 0
    bottom 0
    right 0

    display flex
    flex-direction column
    justify-content center
    align-items center

    > .glyph
      background-image url('../../../../../../../../../images/web_interface_sprite@2x.png')
      background-size 192px 408px
      background-repeat no-repeat
      width 20px
      height 20px

    &.playLive
      > .glyph
        background-size -2px -4px

    &.pauseToggle
      > .glyph
        background-position -26px -2px

    &.stop
      > .glyph
        background-size 192px 408px
        background-position -26px -2px // same as pause, TODO: change

    &.enabled
      cursor pointer
      opacity 1.0
      z-index 10

      &:hover
        background-color #cdd7dc
        color #f0f3f4
