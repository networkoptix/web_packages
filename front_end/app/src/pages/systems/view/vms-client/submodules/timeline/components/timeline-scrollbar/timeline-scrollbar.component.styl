:host
  display block
  position absolute
  bottom 0
  left 0
  right 0
  width 100%
  height 14px
  background transparent

  > .background
    position absolute
    top 0
    bottom 0
    left 0
    right 0

    > .current-playback-indicator
      width 1px
      background-color black
      position absolute
      bottom 0
      top 0
      opacity 0.0
      transition opacity 0.2s ease-in-out
      z-index 10
      &.active
        opacity 1.0

    > .bar
      position absolute
      top 0
      bottom 0
      background #95a6b1
      cursor grab
      min-width 50px

      display flex
      flex-direction row
      justify-content center
      align-items center
      > .stripe
        display block
        width 0.5px
        height 7px
        background-color #6f8694

        &:first-child
          margin-right 3.5px

        &:last-child
          margin-left 3.5px

      &:hover
        background #a8b6bf

      &.grabbed
        cursor grabbing

  > .button
    position absolute
    top -20px
    width 20px
    height 40px
    cursor pointer
    background #0002
    opacity 0.0
    transition opacity 0.2s ease-in-out
    &.enabled
      opacity 1.0

    &.left
      left 0

    &.right
      right 0

