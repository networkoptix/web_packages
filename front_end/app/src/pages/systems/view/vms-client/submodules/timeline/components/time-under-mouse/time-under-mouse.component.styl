:host
  display block
  position absolute
  left 0
  top 5px
  height 45px
  width 140px
  padding-left 5px
  pointer-events none
  transform translateX(-50%)

  text-align center
  background rgba(205,215,220, 0.9)
  color rgb(43, 56, 63)
  z-index 100

  > svg
    position absolute
    bottom -10px
    left -20px
    right -20px
    width 180px
    height 10px
    > polygon
      fill rgba(205,215,220, 0.9)

  > .vertical-line
    content ''
    width 2px
    height 25px
    background-color rgba(205,215,220, 0.9)
    position absolute
    left 50%
    bottom -33px
    transform translateX(-50%)


  > span
    display block
    text-align center

    &.date
      padding-top 2px
      font-size 13px
      line-height 1.5em
      font-family Roboto, Helvetica, sans-serif

    &.time
      text-transform uppercase
      font-weight bold
      font-size 16px
      line-height 1.0em
      font-family 'robotobold', Roboto, Helvetica, sans-serif
