import { float } from '../numberTypeAliases'
import TimeRange from '../timeRanges/TimeRange'

import RulerRenderer from '../renderers/RulerRenderer'
import DebugRenderer from '../renderers/DebugRenderer'
import EventBirdViewRenderer from '../renderers/EventBirdViewRenderer'
import ScrollBarRenderer from '../renderers/ScrollBarRenderer'

import IEventBirdViewProvider from '../birdViews/providers/IEventBirdViewProvider'


export class RelativeTimeRangeZoomer {
  protected cfg = {
    zoom: {
      wheelSensibility: 0.01,
    },
    baseFont: {
      paddingLeftPx: 2,
      paddingTopPx: 90 * devicePixelRatio,
      sizePx: 10 * devicePixelRatio,
      face: 'Arial',
    },
    serifs: {
      interval: 7 * 24 * 60 * 60 * 1000,
      labelDateFormat: undefined, // 'mm:ss',
      offsetRelative: 0.2,
      heightRelative: 0.05,
      font: {
        paddingPx: 5,
        sizePx: 10,
        face: 'Arial',
      }
    }
  }

  protected get maxZoomFactor (): float {
    return this.range.duration / (this.ctx.canvas.width * devicePixelRatio)
  }
  
  protected zoomState = {
    relativeOffset: 0.0,
    zoomFactor: 1.0,
    vetters: {
      vetZoomFactor: () => {
        if (this.zoomState.zoomFactor < 1.0) {
          this.zoomState.zoomFactor = 1.0
        }
        if (this.zoomState.zoomFactor > this.maxZoomFactor) {
          this.zoomState.zoomFactor = this.maxZoomFactor
        }
      },
      vetRelativeOffset: () => {
        if (this.zoomState.relativeOffset < 0) {
          this.zoomState.relativeOffset = 0
        }
        if (this.zoomState.relativeOffset > 1.0 - 1 / this.zoomState.zoomFactor) {
          this.zoomState.relativeOffset = 1.0 - 1 / this.zoomState.zoomFactor
        }
      }
    },
    dragState: {
      isDragging: false,
      anchor: -1,
      referenceRelativeOffset: -1.0,
      isScrollbarMode: false,
    }
  }

  constructor (
    protected followLive: boolean = false,
    protected archiveRange: TimeRange,
    protected ctx: CanvasRenderingContext2D,
    protected eventBirdViewProvider: IEventBirdViewProvider,
    protected callbacks: any,
  ) {
    this.attachEventListeners()
  }

  public dispose (): void {
    this.removeEventListeners()
  }

  public get range (): TimeRange {
    return this.followLive ? new TimeRange(this.archiveRange.startTime, Date.now()) : this.archiveRange
  }

  public get visibleRange (): TimeRange {
    return this.range.getSubRange(this.zoomState.relativeOffset, this.zoomState.zoomFactor)
  }

  public render (debug: boolean = false) {    
    RulerRenderer.render(
      this.ctx,
      this.visibleRange,
    )

    const eventBirdView = this.eventBirdViewProvider.getEventBirdView(this.visibleRange)
    EventBirdViewRenderer.render(this.ctx, eventBirdView)    

    ScrollBarRenderer.render(
      this.ctx,
      {
        relativeOffset: this.zoomState.relativeOffset,
        zoomFactor: this.zoomState.zoomFactor,
      }
    )

    if (debug) {
      DebugRenderer.render(
        this.ctx,
        this.visibleRange,
        this.zoomState.zoomFactor,
        this.zoomState.relativeOffset,
        this.cfg.baseFont,
      )
    }
  }

  protected attachEventListeners () { 
    this.ctx.canvas.addEventListener('wheel', this.eventHandlers.wheelZoom.progress)

    this.ctx.canvas.addEventListener('mousedown', this.eventHandlers.drag.init)
    document.body.addEventListener('mousemove', this.eventHandlers.drag.progress)
    document.body.addEventListener('mouseup', this.eventHandlers.drag.finish)
    document.body.addEventListener('mouseleave', this.eventHandlers.drag.finish)

    this.ctx.canvas.addEventListener('click', this.eventHandlers.dblclick)
  }

  protected removeEventListeners () {
    this.ctx.canvas.removeEventListener('wheel', this.eventHandlers.wheelZoom.progress)

    this.ctx.canvas.removeEventListener('mousedown', this.eventHandlers.drag.init)
    document.body.removeEventListener('mousemove', this.eventHandlers.drag.progress)
    document.body.removeEventListener('mouseup', this.eventHandlers.drag.finish)
    document.body.removeEventListener('mouseleave', this.eventHandlers.drag.finish)

    this.ctx.canvas.addEventListener('click', this.eventHandlers.dblclick)
  }

  public controls = {
    zoom: {
      zoomIn: () => {   
        this.zoomState.zoomFactor *= 2
        this.zoomState.vetters.vetZoomFactor()
      },
      zoomOut: () => {
        this.zoomState.zoomFactor /= 2
        this.zoomState.vetters.vetZoomFactor()
        this.zoomState.vetters.vetRelativeOffset()
      }
    },
    scroll: {
      scrollLeft: () => {      
        this.zoomState.relativeOffset -= 1 / this.zoomState.zoomFactor      
        this.zoomState.vetters.vetRelativeOffset()
      },
      scrollRight: () => {
        this.zoomState.relativeOffset += 1 / this.zoomState.zoomFactor
        this.zoomState.vetters.vetRelativeOffset()
      },
      dblScrollLeft: () => {
        this.zoomState.relativeOffset = -Infinity
        this.zoomState.vetters.vetRelativeOffset()
      },
      dblScrollRight: () => {
        this.zoomState.relativeOffset = +Infinity
        this.zoomState.vetters.vetRelativeOffset()
      }
    }
  }

  protected eventHandlers = {
    wheelZoom: {
      progress: (e: WheelEvent) => {
        e.preventDefault()        
        if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
          const anchor = (e.offsetX / this.ctx.canvas.width) * devicePixelRatio

          const wheelDelta = e.deltaY * this.cfg.zoom.wheelSensibility
          
          const oldZoomFactor = this.zoomState.zoomFactor
    
          this.zoomState.zoomFactor *= (1.0 + wheelDelta)
          
          this.zoomState.vetters.vetZoomFactor()

          this.zoomState.relativeOffset += anchor * (1 / oldZoomFactor - 1 / this.zoomState.zoomFactor)

          this.zoomState.vetters.vetRelativeOffset()
        } else {
          this.zoomState.relativeOffset *= (1 + e.deltaX * this.cfg.zoom.wheelSensibility * this.cfg.zoom.wheelSensibility)
          this.zoomState.vetters.vetRelativeOffset()
        }
      }
    },
    scrollTo: (e: MouseEvent) => {
      const anchor = e.offsetX * devicePixelRatio / this.ctx.canvas.width
      this.zoomState.relativeOffset = anchor - 0.5 / this.zoomState.zoomFactor
      this.zoomState.vetters.vetRelativeOffset()
    },
    drag: {
      init: (e: MouseEvent) => {
        e.preventDefault()
        const SCROLLBAR_STARTS_AT = 0.9
        this.zoomState.dragState.isScrollbarMode =
          e.offsetY * devicePixelRatio / this.ctx.canvas.height > SCROLLBAR_STARTS_AT
        if (this.zoomState.dragState.isScrollbarMode) {
          const anchor = e.offsetX * devicePixelRatio / this.ctx.canvas.width
          const MIN_SCROLL_WIDTH = 50 * devicePixelRatio / this.ctx.canvas.width
          if (anchor > this.zoomState.relativeOffset &&
            anchor < this.zoomState.relativeOffset +
              Math.max(1 / this.zoomState.zoomFactor, MIN_SCROLL_WIDTH)
          ) {
            this.zoomState.dragState.isDragging = true
          } else {
            this.eventHandlers.scrollTo(e)
          }
        } else {
          this.zoomState.dragState.isDragging = true
          this.zoomState.dragState.anchor = e.screenX
          this.zoomState.dragState.referenceRelativeOffset = this.zoomState.relativeOffset
        }
      },
      finish: (e: MouseEvent) => {
        e.preventDefault()
        this.zoomState.dragState.isDragging = false
      },
      progress: (e: MouseEvent) => {
        if (this.zoomState.dragState.isDragging) {
          e.preventDefault()
          if (this.zoomState.dragState.isScrollbarMode) {
            const offset = Math.min(Math.max(0, e.screenX - this.ctx.canvas.offsetLeft), this.ctx.canvas.getBoundingClientRect().width)
            const anchor = offset * devicePixelRatio / this.ctx.canvas.width
            this.zoomState.relativeOffset = anchor - 0.5 / this.zoomState.zoomFactor
          } else {
            this.zoomState.relativeOffset = this.zoomState.dragState.referenceRelativeOffset -
              (e.screenX - this.zoomState.dragState.anchor) / document.body.clientWidth / this.zoomState.zoomFactor            
          }
          this.zoomState.vetters.vetRelativeOffset()
        }
      }
    },
    dblclick: (e: MouseEvent) => {
      if (this.callbacks.onTimeLineClick && typeof(this.callbacks.onTimeLineClick) === 'function') {
        e.preventDefault()
        
        const SCROLLBAR_STARTS_AT = 0.9
        if (e.offsetY * devicePixelRatio / this.ctx.canvas.height > SCROLLBAR_STARTS_AT)
          return
        
          const anchor = (e.offsetX / this.ctx.canvas.width) * devicePixelRatio
        const time = this.visibleRange.startTime + anchor * this.visibleRange.duration
        this.callbacks.onTimeLineClick(time)
      }
    }  
  }
}

export default RelativeTimeRangeZoomer
