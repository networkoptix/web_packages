export type TimeStampMs = number
export const NOW:TimeStampMs = Date.now()
// export const NOW:TimeStampMs = 1e10

export type TimeDiffMs = number

export interface TimeRangeStartEnd {
    start: TimeStampMs,
    end: TimeStampMs,
}

export interface TimeRangeStartEndDuration extends TimeRangeStartEnd {
    duration: TimeDiffMs
}

export class TimeRange implements TimeRangeStartEndDuration {
    // TODO: setters with orientation check
    public start: TimeStampMs
    public end: TimeStampMs
    
    constructor ({ start, end }: TimeRangeStartEnd) {        
        if (start > end) {
            [start, end] = [end, start]
        }
        this.start = start
        this.end = end
    }

    public get duration (): TimeDiffMs {
        return this.end - this.start
    }
    
    public isValid (): boolean {
        return this.duration > 0
    }
}

export interface TimeRangeWithDetailization extends TimeRangeStartEndDuration{
    children?: Array<TimeRangeWithDetailization>
}

export type TimeIntervalMs = number
export type TimeIntervalApproxMs = TimeIntervalMs

export const SECOND:        TimeIntervalApproxMs     =   1000
export const MINUTE:        TimeIntervalApproxMs     =   60 * SECOND
export const HOUR:          TimeIntervalApproxMs     =   60 * MINUTE
export const DAY:           TimeIntervalApproxMs     =   24 * HOUR
export const MONTH:         TimeIntervalApproxMs     =   30 * DAY
export const QUARTER_YEAR:  TimeIntervalApproxMs     =   3 * MONTH
export const HALF_YEAR:     TimeIntervalApproxMs     =   6 * MONTH
export const YEAR:          TimeIntervalApproxMs     =   12 * MONTH
export const DECADE:        TimeIntervalApproxMs     =   10 * YEAR
export const CENTURY:       TimeIntervalApproxMs     =   100 * YEAR

export const LABEL_FORMAT_SECONDS_ONLY = 'ss"s"'
export const LABEL_FORMAT_HOURS_24 = 'HH:MM'
export const LABEL_FORMAT_HOURS_24_SECONDS = 'HH:MM:ss'
export const LABEL_FORMAT_DAY = 'dd'
export const LABEL_FORMAT_DAY_OF_YEAR = 'd mmmm yyyy'
export const LABEL_FORMAT_MONTH = 'mmmm'
export const LABEL_FORMAT_YEAR = 'yyyy'
export const LABEL_FORMAT_MONTH_AND_YEAR = 'mmmm yyyy'