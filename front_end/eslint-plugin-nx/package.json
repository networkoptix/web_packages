{
    "name": "eslint-plugin-nx",
    "version": "0.1.0",
    "main": "build/index.js",
    "license": "ISC",
    "scripts": {
        "watch": "tsc --project ./tsconfig.build.json -w",
        "test": "npx ts-mocha --require fixtures.js src/tests/*.test.ts",
        "build": "tsc --project ./tsconfig.build.json",
        "build-check": "mv ./build ./build-copy; npm run build; build_diff=$(diff -r ./build ./build-copy); if [ ! -z \"$build_diff\" ]; then exit 1; fi",
        "lint": "cd ..; npx eslint --fix \"./eslint-plugin-nx/**/*.ts\""
    },
    "devDependencies": {
        "mocha": "^10.0.0",
        "ts-mocha": "^10.0.0",
        "ts-node": "^10.9.1"
    }
}
