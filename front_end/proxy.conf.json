{
    "/api/utils/language": {
        "note": "this should be the first node... if not - update_proxy.py re-ordered keys (possible issue - you're running Py2)",
        "target": "https://dev2.cloud.hdw.mx",
        "secure": false,
        "logLevel": "debug",
        "changeOrigin": true
    },
    "/admin/": {
        "target": "https://dev2.cloud.hdw.mx",
        "secure": false,
        "logLevel": "debug",
        "changeOrigin": true
    },
    "/api/*": {
        "target": "https://dev2.cloud.hdw.mx",
        "secure": false,
        "logLevel": "debug",
        "changeOrigin": true
    },
    "/static/503.html": {
        "target": "https://dev2.cloud.hdw.mx",
        "secure": false,
        "logLevel": "debug",
        "changeOrigin": true
    },
    "/static/lang_en_US/language_compiled.json": {
        "target": "https://dev2.cloud.hdw.mx",
        "secure": false,
        "logLevel": "debug",
        "changeOrigin": true
    },
    "/static/scripts/commonPasswordsList.json": {
        "target": "https://dev2.cloud.hdw.mx",
        "secure": false,
        "logLevel": "debug",
        "changeOrigin": true
    },
    "/static/lang_en_US/views/static/*": {
        "target": "https://dev2.cloud.hdw.mx",
        "secure": false,
        "logLevel": "debug",
        "changeOrigin": true
    },
    "/static/lang_en_US/*": {
        "target": "https://localhost:9000",
        "secure": false,
        "logLevel": "debug",
        "changeOrigin": true,
        "pathRewrite": {
            "^/static/lang_en_US/views": "/views"
        }
    },
    "/static/images/*": {
        "target": "https://dev2.cloud.hdw.mx",
        "secure": false,
        "logLevel": "debug",
        "changeOrigin": true
    },
    "/static/languages.json": {
        "target": "https://dev2.cloud.hdw.mx",
        "secure": false,
        "logLevel": "debug",
        "changeOrigin": true
    },
    "/static/*": {
        "target": "https://localhost:9000",
        "secure": false,
        "logLevel": "debug",
        "changeOrigin": true,
        "pathRewrite": {
            "^/static/": ""
        }
    }
}