{
    "name": "unconverted",
    "$schema": "../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "generators": {
        "@schematics/angular:component": {
            "style": "scss"
        }
    },
    "sourceRoot": "unconverted/src",
    "prefix": "app",
    "targets": {
        "lint": {
            "executor": "@nrwl/linter:eslint",
            "options": {
                "eslintConfig": "./.eslintrc.js",
                "lintFilePatterns": ["./**/*.ts", "./**/*.component.html"],
                "exclude": ["**/node_modules/**", "**/src/**", "**/lib/**", "**/apps/**"]
            }
        },
        "test": {
            "executor": "@angular-devkit/build-angular:karma",
            "options": {
                "main": "common/test.ts",
                "polyfills": "unconverted/src/polyfills.ts",
                "tsConfig": "unconverted/tsconfig.spec.json",
                "karmaConfig": "unconverted/karma.conf.ci.js",
                "assets": [],
                "styles": ["libs/dialogs/dialogs.scss", "common/styles/main.scss"],
                "stylePreprocessorOptions": {
                    "includePaths": [
                        "node_modules/",
                        "common/styles/common",
                        "common/styles",
                        "libs"
                    ]
                },
                "scripts": [],
                "codeCoverage": true
            }
        }
    }
}
