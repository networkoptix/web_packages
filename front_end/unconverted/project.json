{
    "name": "unconverted",
    "$schema": "../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "generators": {
        "@schematics/angular:component": {
            "style": "scss"
        }
    },
    "sourceRoot": "unconverted/src",
    "prefix": "app",
    "targets": {
        "lint": {
            "executor": "@nrwl/linter:eslint",
            "options": {
                "eslintConfig": "./.eslintrc.js",
                "lintFilePatterns": ["./**/*.ts", "./**/*.component.html"],
                "exclude": ["**/node_modules/**", "**/src/**", "**/lib/**", "**/apps/**", "**/libs/*-buildable/**"]
            }
        }
    }
}
