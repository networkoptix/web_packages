{
    "name": "unconverted",
    "$schema": "../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "generators": {
        "@schematics/angular:component": {
            "style": "scss"
        }
    },
    "sourceRoot": "unconverted/src",
    "prefix": "app",
    "targets": {
        "lint": {
            "executor": "@nrwl/linter:eslint",
            "options": {
                "eslintConfig": "./.eslintrc.js",
                "lintFilePatterns": ["./**/*.ts", "./**/*.component.html"],
                "ignorePatterns": [
                    "**/dist/**",
                    "**/node_modules/**",
                    "**/src/**",
                    "**/lib/**",
                    "**/apps/**",
                    "**/libs/*-buildable/**",
                    "**/libs/components/**",
                    "**/libs/features/**",
                    "**/libs/services/**",
                    "**/libs/pipes/**",
                    "**/libs/menu/**",
                    "**/libs/utils/**",
                    "**/libs/dialogs/**",
                    "**/libs/directives/**",
                    "**/libs/interceptors/**",
                    "**/libs/resolvers/**",
                    "**/libs/routeGuards/**"
                ]
            }
        }
    }
}
