{
  "name": "cloud-portal",
  "version": "22.1.0",
  "sideEffects": false,
  "engines": {
    "npm": ">=8 <9",
    "node": "=16.13.1",
    "engineStrict": "true"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "dist/authorization",
          "dist/front_end",
          "{projectRoot}/dist"
        ]
      }
    }
  },
  "scripts": {
    "ng": "nx",
    "serve": "export CLOUD_TARGET=local && npm run serve:cloud",
    "serve-cloud-test": "export CLOUD_TARGET=cloud-test && npm run serve:cloud",
    "serve-dev2": "export CLOUD_TARGET=dev2 && npm run serve:cloud",
    "serve-dev3": "export CLOUD_TARGET=dev3 && npm run serve:cloud",
    "serve-stage": "export CLOUD_TARGET=stage && npm run serve:cloud",
    "serve-webadmin": "npm run serve:webadmin",
    "serve-webadmin-local": "export WEBADMIN_TARGET=local && npm run serve:webadmin",
    "serve-webadmin-demo": "export WEBADMIN_TARGET=demo && npm run serve:webadmin",
    "serve-webadmin-nuke": "export WEBADMIN_TARGET=nuke && npm run serve:webadmin",
    "serve-webadmin-sofia": "export WEBADMIN_TARGET=sofia && npm run serve:webadmin",
    "serve-webadmin-webpi": "export WEBADMIN_TARGET=webpi && npm run serve:webadmin",
    "serve-webadmin-amir1": "export WEBADMIN_TARGET=amir1 && npm run serve:webadmin",
    "serve-webadmin-amir2": "export WEBADMIN_TARGET=amir2 && npm run serve:webadmin",
    "serve:auth": "npm run setVarSkin && npm run lang && npm run update-lang-types && npx nx serve authorization --configuration development --proxy-config proxy.conf.auth.js",
    "serve:cloud": "npm run setVarSkin && npm run lang && npm run update-lang-types && npx nx serve front-end -c $CLOUD_TARGET --proxy-config proxy.conf.front_end.js",
    "serve:webadmin": "npm run lang && npm run update-lang-types && npx nx serve front-end  -c webadmin --proxy-config proxy.conf.webadmin.js",
    "build": "([ -e ./dist ] && rm -rf ./dist); npm run lang && nx run-many --target=build --projects=front-end,authorization --configuration=production",
    "build:auth": "npx nx build authorization --configuration production",
    "build:cloud": "npm run lang && npx nx build front-end --configuration production",
    "build-webadmin": "([ -e ./dist ] && rm -rf ./dist); npm run lang && npx nx build front-end -c webadmin-prod",
    "bundle-report": "npm run lang && npx nx build front-end --configuration production --stats-json && webpack-bundle-analyzer dist/stats.json -s gzip",
    "bundle-report:auth": "npm run lang && npx nx build authorization --configuration production --stats-json && webpack-bundle-analyzer dist/authorization/stats.json -s gzip",
    "explore:js": "source-map-explorer ./dist/*.js",
    "explore:css": "source-map-explorer ./dist/*.css",
    "postbuild": "./cloud-portal-postbuild.sh",
    "postbuild-webadmin": "./cloud-portal-postbuild.sh true",
    "set-node-version": "npx n 16.13.1",
    "postinstall": "ngcc && node setSkin.mjs --skin blue && node ./decorate-angular-cli.js",
    "test": "npx nx test front-end --karma-config karma.conf.js",
    "test:ci-front-end": "npx nx test front-end --karma-config karma.conf.ci.js --code-coverage",
    "test:ci-authorization": "npx nx test front-end --karma-config karma.conf.ci.js --code-coverage",
    "test:watch": "npx nx test front-end --karma-config karma.conf.watch.js",
    "test:chrome": "npx nx test front-end --browsers Chrome --karma-config karma.conf.watch.js",
    "test:safari": "npx nx test front-end --browsers Safari --karma-config karma.conf.watch.js",
    "test:firefox": "npx nx test front-end --browsers Firefox --karma-config karma.conf.watch.js",
    "test:all": "npx nx test front-end --browsers Chrome,Safari,Firefox --karma-config karma.conf.watch.js",
    "test:components": "npx nx test front-end --include=src/app/components",
    "test:components:watch": "npx nx test front-end --include=src/app/components --karma-config karma.conf.watch.js",
    "e2e": "ng e2e",
    "lint": "eslint src --ext .ts --ignore-pattern *.spec.ts --fix",
    "lint:ci": "eslint --ext .ts --ignore-pattern *.spec.ts --max-warnings 0",
    "lint:ci:tests": "eslint --ext .spec.ts --max-warnings 0",
    "lint:ci:auth": "eslint --ext .ts --max-warnings 0",
    "lint:tests": "eslint src --ext .spec.ts --fix",
    "lint:all": "eslint src --ext .ts --fix",
    "lint:auth": "eslint apps/authorization/src --ext .ts --ignore-pattern *.spec.ts",
    "lint:auth:all": "eslint apps/authorization/src --ext .ts --fix",
    "lint-templates": "eslint . --ext .component.html --fix",
    "lint-templates:ci": "eslint --ext .component.html",
    "esprint": "node esprintLimiter.js",
    "esprint4": "esprint check --fix --workers=4",
    "esprint8": "esprint check --fix --workers=8",
    "lang": "node checkIfLangNeedsUpdate.mjs && npm run update-lang && npm run fill-lang && npm run compile-lang && npm run test-lang || exit 0",
    "removeDeadCss": "node deadCss.mjs",
    "buildSkins": "node buildSkins.mjs",
    "setSkin": "node setSkin.mjs --skin",
    "setVarSkin": "node buildSkins.mjs ./src/styles",
    "update-lang-files": "npm run lang && npm run update-lang-types",
    "lang-ci-check": "cp ./src/language_i18n.json ./src/i18n_copy.json; cp ./src/language_i18n_static_types.ts ./src/types_copy.ts; npm run update-lang-files; cmp_i18n=$(cmp ./src/language_i18n.json ./src/i18n_copy.json); cmp_types=$(cmp ./src/language_i18n_static_types.ts ./src/types_copy.ts); if [ ! -z \"$cmp_i18n\" ] || [ ! -z \"$cmp_types\" ]; then exit 1; fi",
    "compile-lang": "python compile-lang.py",
    "fill-lang": "python fill-lang.py",
    "test-lang": "node --experimental-specifier-resolution=node testCompiledLang.mjs",
    "update-lang": "ngx-translate-extract -i ./src/app ./apps/authorization/src -o ./src/language_i18n.json --clean --sort --format json",
    "update-lang-types": "quicktype ./src/language_i18n_static.json -o ./src/language_i18n_static_types.ts --just-types; sed -i -e 's/string;/TranslateFuncType;/g' src/language_i18n_static_types.ts; sed -i -e 's/string /TranslateFuncType /g' src/language_i18n_static_types.ts; sed -i -e 's/TranslateFuncType/(params?: Record<string, string | number>) => string/g' src/language_i18n_static_types.ts; rm -f src/language_i18n_static_types.ts-e",
    "link-local-libs": "node src/lib/link-libs.js",
    "publish-public-libraries": "node src/lib/publish-public-libs.js",
    "node-modules": "rm -rf node_modules && npm i --legacy-peer-deps"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "14.1.1",
    "@angular/cdk": "14.1.1",
    "@angular/common": "14.1.1",
    "@angular/compiler": "14.1.1",
    "@angular/core": "14.1.1",
    "@angular/fire": "^7.4.1",
    "@angular/forms": "14.1.1",
    "@angular/platform-browser": "14.1.1",
    "@angular/platform-browser-dynamic": "14.1.1",
    "@angular/router": "14.1.1",
    "@angular/service-worker": "14.1.1",
    "@fullstory/browser": "^1.6.1",
    "@ngneat/until-destroy": "9.2.2",
    "@ngrx/store": "13.0.2",
    "@ngx-translate/core": "14.0.0",
    "@ngx-translate/http-loader": "7.0.0",
    "@nrwl/angular": "^14.7.5",
    "@swimlane/ngx-charts": "20.1.0",
    "@tinymce/tinymce-angular": "6.0.1",
    "@vime/core": "^5.3.1",
    "angular-svg-icon": "14.0.0",
    "bootstrap": "4.5.2",
    "dateformat": "3.0.3",
    "drange": "1.0.2",
    "file-saver": "2.0.5",
    "firebase": "9.8.4",
    "lodash-es": "^4.17.21",
    "logrocket": "^3.0.1",
    "marked": "^4.0.17",
    "md5": "2.2.1",
    "messageformat": "2.3.0",
    "ng-qrcode": "6.0.0",
    "ngx-clipboard": "15.1.0",
    "ngx-cookie-service": "13.2.1",
    "ngx-device-detector": "3.0.0",
    "ngx-file-drop": "14.0.1",
    "ngx-hover-preload": "0.0.3",
    "ngx-indexed-db": "11.0.2",
    "ngx-markdown": "14.0.1",
    "ngx-mask": "13.1.15",
    "ngx-quicklink": "0.3.0",
    "ngx-translate-cut": "2.0.0",
    "ngx-translate-messageformat-compiler": "5.0.1",
    "ngx-webstorage": "9.0.0",
    "rxjs": "7.5.5",
    "swagger-ui": "4.11",
    "tinymce": "^5.8.2",
    "tslib": "2.0.0",
    "uuid": "^8.3.2",
    "video.js": "7.20.1",
    "what-input": "5.2.12",
    "zone.js": "0.11.7"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "14.1.1",
    "@angular-eslint/builder": "14.0.2",
    "@angular-eslint/eslint-plugin": "14.0.2",
    "@angular-eslint/eslint-plugin-template": "14.0.2",
    "@angular-eslint/schematics": "14.0.2",
    "@angular-eslint/template-parser": "14.0.2",
    "@angular/cli": "14.1.1",
    "@angular/compiler-cli": "14.1.1",
    "@angular/language-service": "14.1.1",
    "@bartholomej/ngx-translate-extract": "8.0.2",
    "@ngrx/store-devtools": "^14.1.0",
    "@nrwl/nx-cloud": "^14.6.2",
    "@nrwl/workspace": "14.7.5",
    "@types/dateformat": "^5.0.0",
    "@types/file-saver": "^2.0.5",
    "@types/jasmine": "~3.6.6",
    "@types/jasminewd2": "~2.0.8",
    "@types/lodash-es": "^4.17.6",
    "@types/md5": "^2.3.2",
    "@types/node": "16.11.47",
    "@types/swagger-ui": "~3.52.0",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "eslint": "^8.18.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-n": "^15.2.4",
    "eslint-plugin-ngrx": "^2.1.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-nx": "file:eslint-plugin-nx",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-rxjs": "^5.0.2",
    "esprint": "^3.6.0",
    "fs-extra": "^10.1.0",
    "glob-hash": "^1.0.5",
    "jasmine-core": "4.0.1",
    "jasmine-spec-reporter": "7.0.0",
    "karma": "6.3.17",
    "karma-chrome-launcher": "3.1.1",
    "karma-coverage": "2.2.0",
    "karma-firefox-launcher": "2.1.2",
    "karma-jasmine": "4.0.1",
    "karma-jasmine-html-reporter": "1.7.0",
    "karma-junit-reporter": "2.0.1",
    "karma-safari-launcher": "1.0.0",
    "karma-spec-reporter": "0.0.33",
    "karma-viewport": "1.0.8",
    "ng-mocks": "~13.5.2",
    "nx": "14.7.5",
    "prettier": "^2.7.1",
    "protractor": "7.0.0",
    "purgecss": "^4.1.3",
    "quicktype": "^15.0.260",
    "sass": "~1.53.0",
    "sass-rem": "3.0.0",
    "source-map-explorer": "^2.5.2",
    "ts-loader": "7.0.4",
    "ts-node": "8.10.1",
    "typescript": "4.6.4",
    "webpack-bundle-analyzer": "~4.5.0"
  }
}
