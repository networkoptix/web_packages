    "engines": {
        "node": ">=12.0.0"
    },
    "jest": {
        "preset": "jest-preset-angular",
        "setupTestFrameworkScriptFile": "<rootDir>/src/setupJest.ts"
    },
    "scripts": {
        "lint": "eslint app/src/**/*.ts --fix",
        "lang": "npm run update-lang; npm run fill-lang; npm run compile-lang;",
        "serve": "npm run update-lang-types; npm run lang; webpack-dev-server --config webpack.dev.js --open --hot --inline",
        "serve-health-monitor": "npm run lang; webpack-dev-server --config webpack.health_monitor-dev.js --open --hot --inline",
        "serve-ipvd": "npm run lang; webpack-dev-server --config webpack.ipvd-dev.js --open --hot --inline",
        "build": "npm run lang; webpack --config webpack.prod.js --progress --profile --bail",
        "build-health-monitor": "npm run lang; webpack --config webpack.health_monitor-prod.js --progress --profile --bail",
        "build-ipvd": "npm run lang; webpack --config webpack.ipvd-prod.js --progress --profile --bail",
        "setSkin": "node setSkin.js --skin",
        "compile-lang": "python compile-lang.py",
        "fill-lang": "python fill-lang.py",
        "update-lang": "ngx-translate-extract -i ./app/src -o ./app/language_i18n.json --clean --sort --format json",
        "update-lang-types": "quicktype ./app/language_i18n_static.json -o ./app/language_i18n_static_types.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "karma start karma.conf.js --single-run"
    }
}
