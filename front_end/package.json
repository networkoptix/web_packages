{
  "name": "cloud-portal",
  "version": "22.1.0",
  "scripts": {
    "ng": "ng",
    "serve": "export CLOUD_TARGET=local && npm run serve:cloud",
    "serve-cloud-test": "export CLOUD_TARGET=cloud-test && npm run serve:cloud",
    "serve-dev2": "export CLOUD_TARGET=dev2 && npm run serve:cloud",
    "serve-dev3": "export CLOUD_TARGET=dev3 && npm run serve:cloud",
    "serve-stage": "export CLOUD_TARGET=stage && npm run serve:cloud",
    "serve-webadmin": "npm run serve:webadmin",
    "serve-webadmin-local": "export WEBADMIN_TARGET=local && npm run serve:webadmin",
    "serve-webadmin-demo": "export WEBADMIN_TARGET=demo && npm run serve:webadmin",
    "serve-webadmin-nuke": "export WEBADMIN_TARGET=nuke && npm run serve:webadmin",
    "serve-webadmin-sofia": "export WEBADMIN_TARGET=sofia && npm run serve:webadmin",
    "serve-webadmin-webpi": "export WEBADMIN_TARGET=webpi && npm run serve:webadmin",
    "serve-webadmin-amir1": "export WEBADMIN_TARGET=amir1 && npm run serve:webadmin",
    "serve-webadmin-amir2": "export WEBADMIN_TARGET=amir2 && npm run serve:webadmin",
    "serve:auth": "npm run setVarSkin && npm run lang && npm run update-lang-types && ng serve authorization --proxy-config proxy.conf.auth.js",
    "serve:cloud": "npm run setVarSkin && npm run lang && npm run update-lang-types && node --max_old_space_size=8048 ./node_modules/@angular/cli/bin/ng serve -c $CLOUD_TARGET --proxy-config proxy.conf.front_end.js",
    "serve:webadmin": "npm run lang && npm run update-lang-types && node --max_old_space_size=8048 ./node_modules/@angular/cli/bin/ng serve -c webadmin --proxy-config proxy.conf.webadmin.js",
    "build": "npm run build:cloud && npm run build:auth",
    "build:auth": "ng build authorization --configuration production",
    "build:cloud": "npm run lang && ng build --configuration production",
    "build-webadmin": "npm run lang && ng build -c webadmin-prod",
    "bundle-report": "npm run lang && ng build --configuration production --stats-json && webpack-bundle-analyzer dist/stats.json -s gzip",
    "bundle-report:auth": "npm run lang && ng build authorization --configuration production --stats-json && webpack-bundle-analyzer dist/authorization/stats.json -s gzip",
    "postbuild": "./cloud-portal-postbuild.sh",
    "postbuild-webadmin": "./cloud-portal-postbuild.sh true",
    "postinstall": "ngcc && node setSkin.js --skin blue",
    "test": "ng test --karma-config karma.conf.js",
    "test:ci": "ng test --karma-config karma.conf.ci.js --code-coverage",
    "test:watch": "ng test --karma-config karma.conf.watch.js",
    "test:chrome": "ng test --browsers Chrome --karma-config karma.conf.watch.js",
    "test:safari": "ng test --browsers Safari --karma-config karma.conf.watch.js",
    "test:firefox": "ng test --browsers Firefox --karma-config karma.conf.watch.js",
    "test:all": "ng test --browsers Chrome,Safari,Firefox --karma-config karma.conf.watch.js",
    "test:components": "ng test --include=app/src/components",
    "test:components:watch": "ng test --include=app/src/components --karma-config karma.conf.watch.js",
    "e2e": "ng e2e",
    "lint": "eslint app --ext .ts --ignore-pattern *.spec.ts --fix",
    "lint:ci": "eslint --ext .ts --ignore-pattern *.spec.ts --max-warnings 0",
    "lint:ci:tests": "eslint --ext .spec.ts --max-warnings 0",
    "lint:tests": "eslint app --ext .spec.ts --fix",
    "lint:all": "eslint app --ext .ts --fix",
    "lint:auth": "eslint projects/authorization/src --ext .ts --fix",
    "esprint": "node esprintLimiter.js",
    "esprint4": "esprint check --fix --workers=4",
    "esprint8": "esprint check --fix --workers=8",
    "lang": "npm run update-lang; npm run fill-lang; npm run compile-lang; npm run test-lang",
    "buildSkins": "node buildSkins.js",
    "setSkin": "node setSkin.js --skin",
    "setVarSkin": "node buildSkins.js ./app/styles",
    "update-lang-files": "npm run lang && npm run update-lang-types:ci",
    "lang-ci-check": "cp ./app/language_i18n.json ./app/i18n_copy.json; cp ./app/language_i18n_static_types.ts ./app/types_copy.ts; npm run update-lang-files; cmp_i18n=$(cmp ./app/language_i18n.json ./app/i18n_copy.json); cmp_types=$(cmp ./app/language_i18n_static_types.ts ./app/types_copy.ts); if [ ! -z \"$cmp_i18n\" ] || [ ! -z \"$cmp_types\" ]; then exit 1; fi",
    "compile-lang": "python compile-lang.py",
    "fill-lang": "python fill-lang.py",
    "test-lang": "node testCompiledLang.js",
    "update-lang": "ngx-translate-extract -i ./app/src ./projects/authorization/src -o ./app/language_i18n.json --clean --sort --format json",
    "update-lang-types": "quicktype ./app/language_i18n_static.json -o ./app/language_i18n_static_types.ts; sed -i -e 's/string;/any;/g' app/language_i18n_static_types.ts; sed -i -e 's/string /any /g' app/language_i18n_static_types.ts; sed -i -e 's/typ: \"\" }/typ: \"any\" }/g' app/language_i18n_static_types.ts; rm -f app/language_i18n_static_types.ts-e",
    "update-lang-types:ci": "quicktype ./app/language_i18n_static.json -o ./app/language_i18n_static_types.ts; sed -i -e 's/string;/any;/g' app/language_i18n_static_types.ts; sed -i -e 's/string /any /g' app/language_i18n_static_types.ts; sed -i -e 's/typ: \"\" }/typ: \"any\" }/g' app/language_i18n_static_types.ts; rm -f app/language_i18n_static_types.ts-e",
    "link-local-libs": "node app/lib/link-libs.js",
    "publish-public-libraries": "node app/lib/publish-public-libs.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "12.2.16",
    "@angular/cdk": "12.2.13",
    "@angular/common": "12.2.16",
    "@angular/compiler": "12.2.16",
    "@angular/core": "12.2.16",
    "@angular/fire": "7.2.0",
    "@angular/forms": "12.2.16",
    "@angular/platform-browser": "12.2.16",
    "@angular/platform-browser-dynamic": "12.2.16",
    "@angular/router": "12.2.16",
    "@angular/service-worker": "12.2.16",
    "@angular/upgrade": "12.2.16",
    "@ngneat/until-destroy": "8.0.3",
    "@ngrx/store": "13.0.2",
    "@ngx-translate/core": "13.0.0",
    "@ngx-translate/http-loader": "6.0.0",
    "@swimlane/ngx-charts": "^16.0.0",
    "@tinymce/tinymce-angular": "^4.2.4",
    "@videojs/http-streaming": "^2.8.0",
    "angular-in-memory-web-api": "0.10.0",
    "angular-svg-icon": "10.0.0",
    "angular2-csv": "0.2.9",
    "bootstrap": "4.5.2",
    "core-js": "3.6.5",
    "dateformat": "3.0.3",
    "firebase": "9.4.1",
    "hls.js": "0.14.16",
    "jquery": "3.5.1",
    "jquery-mousewheel": "3.1.13",
    "lodash-es": "^4.17.21",
    "md5": "2.2.1",
    "messageformat": "2.3.0",
    "ng-qrcode": "^4.2.0",
    "ng2-trim-directive": "2.3.4",
    "ngx-clipboard": "14.0.2",
    "ngx-cookie-service": "3.0.4",
    "ngx-device-detector": "1.4.2",
    "ngx-file-drop": "8.0.8",
    "ngx-markdown": "^11.0.0",
    "ngx-mask": "11.1.4",
    "ngx-order-pipe": "2.0.1",
    "ngx-quicklink": "^0.2.6",
    "ngx-translate-messageformat-compiler": "4.7.0",
    "ngx-webstorage": "5.0.0",
    "ngx-window-token": "6.0.0",
    "rangeslider.js": "2.3.2",
    "rxjs": "6.6.7",
    "rxjs-compat": "6.6.7",
    "swagger-ui": "3.40.0",
    "tinymce": "^5.8.2",
    "tslib": "^2.0.0",
    "underscore": "^1.13.1",
    "video.js": "^7.18.0",
    "what-input": "5.2.10",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "12.2.16",
    "@angular-devkit/build-optimizer": "~0.1102.18",
    "@angular/cli": "12.2.16",
    "@angular/compiler-cli": "12.2.16",
    "@angular/language-service": "12.2.16",
    "@angular/localize": "^12.2.16",
    "@babel/preset-env": "^7.12.1",
    "@biesbjerg/ngx-translate-extract": "~6.1.0",
    "@types/core-js": "2.5.3",
    "@types/hammerjs": "2.0.36",
    "@types/hls.js": "^0.12.6",
    "@types/jasmine": "~3.6.6",
    "@types/jasminewd2": "~2.0.8",
    "@types/lodash-es": "^4.17.6",
    "@types/node": "^12.11.1",
    "@types/webpack": "4.41.13",
    "@typescript-eslint/eslint-plugin": "^5.16.0",
    "@typescript-eslint/parser": "^5.16.0",
    "angular2-template-loader": "0.6.2",
    "babel-core": "^6.26.3",
    "babel-loader": "^8.1.0",
    "clean-webpack-plugin": "0.1.19",
    "codelyzer": "^6.0.0",
    "copy-webpack-plugin": "^7.0.0",
    "eslint": "^8.11.0",
    "eslint-config-standard": "^16.0.3",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-ngrx": "^2.0.4",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-nx": "file:eslint-plugin-nx",
    "eslint-plugin-promise": "^6.0.0",
    "esprint": "^3.3.0",
    "html-loader": "^1.1.0",
    "html-webpack-plugin": "^4.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jasmine-core": "4.0.1",
    "jasmine-spec-reporter": "7.0.0",
    "karma": "6.3.17",
    "karma-chrome-launcher": "3.1.1",
    "karma-coverage": "2.2.0",
    "karma-firefox-launcher": "2.1.2",
    "karma-jasmine": "4.0.1",
    "karma-jasmine-html-reporter": "1.7.0",
    "karma-junit-reporter": "2.0.1",
    "karma-safari-launcher": "1.0.0",
    "karma-spec-reporter": "0.0.33",
    "karma-viewport": "1.0.8",
    "mini-css-extract-plugin": "0.9.0",
    "ng-mocks": "^12.5.0",
    "protractor": "7.0.0",
    "quicktype": "^15.0.260",
    "sass": "1.32.8",
    "sass-rem": "3.0.0",
    "ts-loader": "7.0.4",
    "ts-node": "8.10.1",
    "typescript": "4.3.5",
    "webpack": "4.43.0",
    "webpack-bundle-analyzer": "^4.5.0",
