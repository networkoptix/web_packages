{
  "name": "cloud-portal",
  "version": "20.2.0",
  "scripts": {
    "ng": "ng",
    "serve": "npm run lang && npm run update-lang-types && ng serve --open --proxy-config proxy.conf.dev2.json",
    "serve-webadmin": "npm run lang && npm run update-lang-types && ng serve -c webadmin --open --proxy-config webadmin-proxy.conf.json",
    "build": "npm run lang && ng build --prod",
    "build-webadmin": "npm run lang && ng build -c webadmin-prod",
    "bundle-report": "npm run lang && ng build --stats-json && webpack-bundle-analyzer dist/stats.json",
    "postbuild": "./cloud-portal-postbuild.sh",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "e2e": "ng e2e",
    "lint": "eslint app/src/**/*.ts --fix",
    "lang": "npm run update-lang; npm run fill-lang; npm run compile-lang;",
    "serve-health-monitor": "npm run lang; webpack-dev-server --config webpack.health_monitor-dev.js --open --hot --inline",
    "serve-ipvd": "npm run lang; webpack-dev-server --config webpack.ipvd-dev.js --open --hot --inline",
    "build-health-monitor": "npm run lang; webpack --config webpack.health_monitor-prod.js --progress --profile --bail",
    "build-ipvd": "npm run lang; webpack --config webpack.ipvd-prod.js --progress --profile --bail",
    "setSkin": "node setSkin.js --skin",
    "compile-lang": "python compile-lang.py",
    "fill-lang": "python fill-lang.py",
    "update-lang": "ngx-translate-extract -i ./app/src -o ./app/language_i18n.json --clean --sort --format json",
    "update-lang-types": "quicktype ./app/language_i18n_static.json -o ./app/language_i18n_static_types.ts; sed -i -e 's/string;/any;/g' app/language_i18n_static_types.ts; sed -i -e 's/string /any /g' app/language_i18n_static_types.ts; sed -i -e 's/typ: \"\" }/typ: \"any\" }/g' app/language_i18n_static_types.ts",
    "postinstall": "node setSkin.js --skin blue"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "9.1.7",
    "@angular/cdk": "9.2.4",
    "@angular/common": "9.1.7",
    "@angular/compiler": "9.1.7",
    "@angular/core": "9.1.7",
    "@angular/fire": "5.4.2",
    "@angular/forms": "9.1.7",
    "@angular/localize": "9.1.7",
    "@angular/platform-browser": "9.1.7",
    "@angular/platform-browser-dynamic": "9.1.7",
    "@angular/router": "9.1.7",
    "@angular/upgrade": "9.1.7",
    "@ng-bootstrap/ng-bootstrap": "6.1.0",
    "@ngneat/until-destroy": "^7.1.6",
    "@ngx-translate/core": "12.1.2",
    "@ngx-translate/http-loader": "4.0.0",
    "angular-in-memory-web-api": "0.10.0",
    "angular-svg-icon": "9.2.0",
    "angular2-csv": "0.2.9",
    "bootstrap": "4.5.0",
    "core-js": "3.6.5",
    "dateformat": "^3.0.3",
    "firebase": "7.6.2",
    "hls.js": "^0.13.2",
    "jquery": "3.4.1",
    "jquery-mousewheel": "3.1.13",
    "md5": "2.2.1",
    "messageformat": "2.3.0",
    "moment": "2.25.3",
    "ng2-trim-directive": "2.3.4",
    "ngstorage": "0.3.11",
    "ngx-clipboard": "13.0.0",
    "ngx-cookie-service": "3.0.4",
    "ngx-device-detector": "1.4.2",
    "ngx-file-drop": "8.0.8",
    "ngx-mask": "^9.0.0",
    "ngx-order-pipe": "2.0.1",
    "ngx-store": "2.1.0",
    "ngx-translate-messageformat-compiler": "4.7.0",
    "popper.js": "1.15.0",
    "rangeslider.js": "2.3.2",
    "resize-observer-polyfill": "^1.5.1",
    "rxjs": "6.5.5",
    "rxjs-compat": "6.5.5",
    "underscore": "1.9.1",
    "what-input": "5.2.9",
    "zone.js": "0.10.3"
  },
  "devDependencies": {
    "@angular-builders/jest": "9.0.1",
    "@angular-devkit/build-angular": "0.901.6",
    "@angular-devkit/build-optimizer": "0.901.6",
    "@angular/cli": "9.1.6",
    "@angular/compiler-cli": "9.1.7",
    "@angular/language-service": "9.1.7",
    "@biesbjerg/ngx-translate-extract": "6.0.4",
    "@types/core-js": "2.5.3",
    "@types/hammerjs": "2.0.36",
    "@types/hls.js": "^0.12.6",
