{
  "name": "cloud-portal",
  "version": "20.2.0",
  "scripts": {
    "ng": "ng",
    "serve": "npm run lang && npm run update-lang-types && ng serve --open --proxy-config proxy.conf.cloud-test.json",
    "serve-cloud-test": "npm run lang && npm run update-lang-types && ng serve --open --proxy-config proxy.conf.cloud-test.json",
    "serve-dev2": "npm run lang && npm run update-lang-types && ng serve --open --proxy-config proxy.conf.dev2.json",
    "serve-webadmin": "npm run lang && npm run update-lang-types && ng serve -c webadmin --open --proxy-config proxy.conf.json",
    "serve-webadmin-local": "npm run lang && npm run update-lang-types && ng serve -c webadmin --open --proxy-config proxy.conf.webadmin.local.json",
    "serve-webadmin-demo": "npm run lang && npm run update-lang-types && ng serve -c webadmin --open --proxy-config proxy.conf.webadmin.demo.json",
    "build": "npm run lang && ng build --prod",
    "build-webadmin": "npm run lang && ng build -c webadmin-prod",
    "bundle-report": "npm run lang && ng build --prod --stats-json && webpack-bundle-analyzer dist/stats.json -s gzip",
    "postbuild": "./cloud-portal-postbuild.sh",
    "postbuild-webadmin": "./cloud-portal-postbuild.sh",
    "postinstall": "ngcc && node setSkin.js --skin blue",
    "test": "jest",
    "test:watch": "ng test --watch",
    "jest": "jest --watchAll",
    "jest:w": "jest --watch",
    "e2e": "ng e2e",
    "lint": "eslint app/src/**/*.ts --fix",
    "lang": "npm run update-lang; npm run fill-lang; npm run compile-lang;",
    "setSkin": "node setSkin.js --skin",
    "compile-lang": "python compile-lang.py",
    "fill-lang": "python fill-lang.py",
    "update-lang": "ngx-translate-extract -i ./app/src -o ./app/language_i18n.json --clean --sort --format json",
    "update-lang-types": "quicktype ./app/language_i18n_static.json -o ./app/language_i18n_static_types.ts; sed -i -e 's/string;/any;/g' app/language_i18n_static_types.ts; sed -i -e 's/string /any /g' app/language_i18n_static_types.ts; sed -i -e 's/typ: \"\" }/typ: \"any\" }/g' app/language_i18n_static_types.ts; rm app/language_i18n_static_types.ts-e"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "10.2.2",
    "@angular/cdk": "10.2.7",
    "@angular/common": "10.2.2",
    "@angular/compiler": "10.2.2",
    "@angular/core": "10.2.2",
    "@angular/fire": "6.0.3",
    "@angular/forms": "10.2.2",
    "@angular/platform-browser": "10.2.2",
    "@angular/platform-browser-dynamic": "10.2.2",
    "@angular/router": "10.2.2",
    "@angular/upgrade": "10.2.2",
    "@ng-bootstrap/ng-bootstrap": "7.0.0",
    "@ngneat/until-destroy": "8.0.3",
    "@ngx-translate/core": "13.0.0",
    "@ngx-translate/http-loader": "6.0.0",
    "angular-in-memory-web-api": "0.10.0",
    "angular-svg-icon": "10.0.0",
    "angular2-csv": "0.2.9",
    "bootstrap": "4.5.2",
    "core-js": "3.6.5",
    "dateformat": "3.0.3",
    "firebase": "7.24.0",
    "hls.js": "0.14.16",
    "jquery": "3.5.1",
    "jquery-mousewheel": "3.1.13",
    "md5": "2.2.1",
