{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "module": "commonjs",
    "types": [
      "jest",
      "jquery",
      "jsdom",
      "node"
    ],
    "esModuleInterop": true,
    "emitDecoratorMetadata": true
  },
  "files": [
    "app/setupJest.ts",
    "app/polyfills.ts"
  ],
  "include": [
    "**/*.spec.ts"
  ],
  "exclude": [
    "node_modules",
    "test",
    "**/*.spec.js"
  ]
}
