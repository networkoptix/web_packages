{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": [
      "jasmine",
      "node",
      "karma-viewport"
    ],
    "esModuleInterop": true
  },
  "files": [
    "app/test.ts",
    "app/polyfills.ts"
  ],
  "include": [
    "app/**/*.spec.ts",
    "app/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "test",
    "app/**/*.spec.js"
  ]
}
