{
    "extends": ["../../tsconfig.json", "../tsconfig.lib.json", "../tsconfig.prod.json"],
    "compilerOptions": {
        "noImplicitAny": true,
        "noImplicitThis": true,
        "alwaysStrict": true,
        "strictBindCallApply": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "strictPropertyInitialization": true
    }
}