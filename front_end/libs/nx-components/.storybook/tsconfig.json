{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "module": "es2022",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "resolveJsonModule": true,
        "jsx": "react"
    },
    "exclude": ["../**/*.spec.ts"],
    "include": [
        "../src/**/*.stories.ts",
        "../src/**/*.stories.js",
        "../src/**/*.stories.jsx",
        "../src/**/*.stories.tsx",
        "../src/**/*.stories.mdx",
        "*.js",
        "*.ts",
        "../src/global.types.ts",
    ],
    "ts-node": {
        "compilerOptions": {
            "module": "commonjs"
        }
    }
}
