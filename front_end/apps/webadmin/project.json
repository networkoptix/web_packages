{
    "projectType": "application",
    "schematics": {
        "@schematics/angular:component": {
            "style": "scss"
        }
    },
    "root": "apps/webadmin",
    "sourceRoot": "apps/webadmin/src",
    "prefix": "app",
    "architect": {
        "build": {
            "builder": "@angular-devkit/build-angular:browser",
            "options": {
                "allowedCommonJsDependencies": [
                    "md5",
                    "uuid",
                    "ng2-trim-directive",
                    "qrcode",
                    "@firebase/util",
                    "@firebase/component",
                    "dateformat",
                    "@videojs/xhr",
                    "videojs-vtt.js",
                    "global/document",
                    "mux.js/lib/mp4/probe",
                    "mux.js/lib/tools/ts-inspector.js",
                    "swagger-ui"
                ],
                "outputPath": "dist/webadmin",
                "index": "apps/webadmin/src/app/index.html",
                "main": "apps/webadmin/src/main.ts",
                "polyfills": "apps/webadmin/src/polyfills.ts",
                "tsConfig": "apps/webadmin/tsconfig.app.json",
                "assets": [
                    {
                        "glob": "**/*",
                        "input": "node_modules/tinymce",
                        "output": "/tinymce/"
                    },
                    {
                        "glob": "**/*",
                        "input": "common/customization",
                        "output": "customization"
                    },
                    {
                        "glob": "**/*",
                        "input": "common/images",
                        "output": "images"
                    },
                    {
                        "glob": "**/*",
                        "input": "common/fonts",
                        "output": "fonts"
                    },
                    {
                        "glob": "**/*",
                        "input": "common/styles",
                        "output": "styles"
                    },
                    {
                        "glob": "**/*",
                        "input": "common/static_assets",
                        "output": "."
                    },
                    {
                        "glob": "**/*",
                        "input": "common/views",
                        "output": "views"
                    },
                    {
                        "glob": "**/*",
                        "input": "common/scripts",
                        "output": "scripts"
                    },
                    {
                        "glob": "**/*",
                        "input": "common/language",
                        "output": "."
                    }
                ],
                "styles": [
                    "libs/dialogs/dialogs.scss",
                    "common/styles/main.scss"
                ],
                "scripts": [],
                "stylePreprocessorOptions": {
                    "includePaths": [
                        "common/styles",
                        "common/styles/common",
                        "libs"
                    ]
                },
                "vendorChunk": true,
                "extractLicenses": false,
                "sourceMap": {
                    "scripts": true,
                    "styles": false,
                    "vendor": false
                },
                "aot": true,
                "optimization": false,
                "namedChunks": true
            },
            "configurations": {
                "development": {
                    "fileReplacements": [
                        {
                            "replace": "common/environments/environment.ts",
                            "with": "common/environments/environment.webadmin.ts"
                        },
                        {
                            "replace": "libs/services/account.service/index.ts",
                            "with": "libs/services/account.service/index.webadmin.ts"
                        },
                        {
                            "replace": "libs/routeGuards/authGuard.ts",
                            "with": "libs/routeGuards/authGuard.webadmin.ts"
                        }
                    ]
                },
                "production": {
                    "deployUrl": "static/",
                    "fileReplacements": [
                        {
                            "replace": "common/environments/environment.ts",
                            "with": "common/environments/environment.webadmin-prod.ts"
                        },
                        {
                            "replace": "libs/services/account.service/index.ts",
                            "with": "libs/services/account.service/index.webadmin.ts"
                        },
                        {
                            "replace": "libs/routeGuards/authGuard.ts",
                            "with": "libs/routeGuards/authGuard.webadmin.ts"
                        }
                    ],
                    "vendorChunk": false,
                    "buildOptimizer": true,
                    "commonChunk": false,
                    "optimization": true,
                    "outputHashing": "all",
                    "sourceMap": false,
                    "extractLicenses": true,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "2mb",
                            "maximumError": "3mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "200kb",
                            "maximumError": "300kb"
                        },
                        {
                            "type": "anyScript",
                            "maximumWarning": "1mb",
                            "maximumError": "2mb"
                        }
                    ]
                }
            },
            "defaultConfiguration": ""
        },
        "lint": {
            "builder": "@nrwl/linter:eslint",
            "options": {
                "eslintConfig": "./.eslintrc.js",
                "lintFilePatterns": [
                    "apps/webadmin/**/*.ts",
                    "apps/webadmin/**/*.component.html"
                ]
            }
        },
        "serve": {
            "builder": "@angular-devkit/build-angular:dev-server",
            "options": {
                "publicHost": "localhost:9001",
                "host": "0.0.0.0",
                "port": 9001,
                "browserTarget": "webadmin:build:development",
                "sslKey": "ssl_keys/server.key",
                "sslCert": "ssl_keys/server.crt",
                "ssl": true
            },
            "configurations": {
                "production": {
                    "browserTarget": "webadmin:build:production"
                },
                "development": {
                    "browserTarget": "webadmin:build:development"
                }
            }
        },
        "test": {
            "builder": "@angular-devkit/build-angular:karma",
            "options": {
                "main": "common/test.ts",
                "polyfills": "apps/webadmin/src/polyfills.ts",
                "tsConfig": "apps/webadmin/tsconfig.spec.json",
                "karmaConfig": "apps/webadmin/karma.conf.ci.js",
                "assets": [],
                "styles": [
                    "libs/dialogs/dialogs.scss",
                    "common/styles/main.scss"
                ],
                "stylePreprocessorOptions": {
                    "includePaths": [
                        "node_modules/",
                        "common/styles",
                        "common/styles/common",
                        "libs"
                    ]
                },
                "scripts": [],
                "codeCoverage": true
            }
        }
    }
}
