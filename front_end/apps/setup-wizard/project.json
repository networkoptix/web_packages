{
    "name": "setup-wizard",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "generators": {
        "@schematics/angular:component": {
            "style": "scss"
        }
    },
    "sourceRoot": "apps/setup-wizard/src",
    "prefix": "app",
    "tags": ["apps:setup-wizard"],
    "targets": {
        "build": {
            "executor": "@nx/angular:webpack-browser",
            "options": {
                "allowedCommonJsDependencies": [
                    "dexie-encrypted",
                    "dateformat",
                    "md5",
                    "@open-draft/until"
                ],
                "outputPath": "dist/setup-wizard",
                "index": "apps/setup-wizard/src/index.html",
                "main": "apps/setup-wizard/src/main.ts",
                "polyfills": "apps/setup-wizard/src/polyfills.ts",
                "tsConfig": "apps/setup-wizard/tsconfig.app.json",
                "aot": true,
                "assets": [
                    "apps/setup-wizard/src/favicon.ico",
                    "apps/setup-wizard/src/assets",
                    "apps/setup-wizard/src/images",
                    {
                        "glob": "**/*",
                        "input": "common/images",
                        "output": "images"
                    },
                    {
                        "glob": "**/*",
                        "input": "common/fonts",
                        "output": "fonts"
                    },
                    {
                        "glob": "**/*",
                        "input": "common/styles",
                        "output": "styles"
                    },
                    {
                        "glob": "**/*",
                        "input": "common/language",
                        "output": "."
                    }
                ],
                "styles": ["common/styles/main.scss", "apps/setup-wizard/src/styles.scss"],
                "stylePreprocessorOptions": {
                    "includePaths": [
                        "node_modules/",
                        "common/styles",
                        "common/styles/common",
                        "libs"
                    ]
                },
                "scripts": [],
                "vendorChunk": true,
                "extractLicenses": false,
                "buildOptimizer": false,
                "sourceMap": {
                    "scripts": true,
                    "styles": true,
                    "vendor": false
                },
                "optimization": false,
                "namedChunks": true
            },
            "configurations": {
                "production": {
                    "tsConfig": "apps/setup-wizard/tsconfig.prod.json",
                    "deployUrl": "static/",
                    "fileReplacements": [
                        {
                            "replace": "common/environments/environment.ts",
                            "with": "common/environments/environment.wizard-prod.ts"
                        }
                    ],
                    "index": {
                        "input": "apps/setup-wizard/src/index.html",
                        "output": "inline.html"
                    },
                    "optimization": {
                        "scripts": true,
                        "styles": {
                            "minify": true,
                            "inlineCritical": false
                        }
                    },
                    "outputHashing": "all",
                    "sourceMap": false,
                    "namedChunks": false,
                    "extractLicenses": true,
                    "vendorChunk": false,
                    "commonChunk": false,
                    "buildOptimizer": true,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "2mb",
                            "maximumError": "5mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "10kb",
                            "maximumError": "20kb"
                        }
                    ]
                },
                "development": {
                    "tsConfig": "apps/setup-wizard/tsconfig.dev.json",
                    "fileReplacements": [
                        {
                            "replace": "common/environments/environment.ts",
                            "with": "common/environments/environment.wizard-dev.ts"
                        }
                    ],
                    "optimization": false,
                    "outputHashing": "all",
                    "namedChunks": true,
                    "extractLicenses": true,
                    "vendorChunk": false,
                    "buildOptimizer": false,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "1mb",
                            "maximumError": "3mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "20kb",
                            "maximumError": "28kb"
                        }
                    ]
                },
                "zoneless": {
                    "tsConfig": "apps/setup-wizard/tsconfig.dev.json",
                    "fileReplacements": [
                        {
                            "replace": "common/environments/environment.ts",
                            "with": "common/environments/environment.wizard-dev.ts"
                        },
                        {
                            "replace": "common/bootstrap/zone.ts",
                            "with": "common/bootstrap/zoneless.ts"
                        }
                    ],
                    "optimization": false,
                    "outputHashing": "all",
                    "namedChunks": true,
                    "extractLicenses": true,
                    "vendorChunk": false,
                    "buildOptimizer": false,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "1mb",
                            "maximumError": "3mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "20kb",
                            "maximumError": "28kb"
                        }
                    ]
                }
            }
        },
        "serve": {
            "executor": "@nx/angular:dev-server",
            "options": {
                "host": "0.0.0.0",
                "port": 9003,
                "sslKey": "ssl_keys/server.key",
                "sslCert": "ssl_keys/server.crt",
                "ssl": true,
                "buildTarget": "setup-wizard:build"
            },
            "configurations": {
                "production": {
                    "buildTarget": "setup-wizard:build:production"
                },
                "development": {
                    "buildTarget": "setup-wizard:build:development"
                },
                "zoneless": {
                    "buildTarget": "setup-wizard:build:zoneless"
                }
            }
        },
        "extract-i18n": {
            "executor": "@angular-devkit/build-angular:extract-i18n",
            "options": {
                "buildTarget": "setup-wizard:build"
            }
        },
        "lint": {},
        "e2e": {
            "executor": "@angular-devkit/build-angular:protractor",
            "options": {
                "protractorConfig": "apps/setup-wizard/e2e/protractor.conf.js",
                "devServerTarget": "setup-wizard:serve"
            },
            "configurations": {
                "production": {
                    "devServerTarget": "setup-wizard:serve:production"
                }
            }
        },
        "test": {}
    }
}
