{
    "name": "front-end",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "generators": {
        "@schematics/angular:component": {
            "style": "scss"
        }
    },
    "sourceRoot": "apps/front-end/src",
    "prefix": "app",
    "tags": ["apps:front-end"],
    "targets": {
        "build": {
            "executor": "@nx/angular:webpack-browser",
            "options": {
                "allowedCommonJsDependencies": [
                    "md5",
                    "uuid",
                    "ng2-trim-directive",
                    "qrcode",
                    "@firebase/util",
                    "@firebase/component",
                    "dateformat",
                    "@videojs/xhr",
                    "videojs-vtt.js",
                    "global/document",
                    "mux.js/lib/mp4/probe",
                    "mux.js/lib/tools/ts-inspector.js",
                    "swagger-ui"
                ],
                "outputPath": "dist/front-end",
                "index": "apps/front-end/src/app/index.html",
                "main": "apps/front-end/src/main.ts",
                "polyfills": "apps/front-end/src/polyfills.ts",
                "tsConfig": "apps/front-end/tsconfig.app.json",
                "webWorkerTsConfig": "apps/front-end/tsconfig.worker.json",
                "assets": [
                    {
                        "glob": "**/*",
                        "input": "node_modules/tinymce",
                        "output": "/tinymce/"
                    },
                    {
                        "glob": "**/*",
                        "input": "common/customization",
                        "output": "customization"
                    },
                    {
                        "glob": "**/*",
                        "input": "common/images",
                        "output": "images"
                    },
                    {
                        "glob": "**/*",
                        "input": "common/fonts",
                        "output": "fonts"
                    },
                    {
                        "glob": "**/*",
                        "input": "common/styles",
                        "output": "styles"
                    },
                    {
                        "glob": "**/*",
                        "input": "common/views",
                        "output": "views"
                    },
                    {
                        "glob": "**/*",
                        "input": "common/scripts",
                        "output": "scripts"
                    },
                    {
                        "glob": "**/*",
                        "input": "common/static_assets",
                        "output": "."
                    },
                    {
                        "glob": "**/*",
                        "input": "common/language",
                        "output": "."
                    }
                ],
                "styles": ["libs/dialogs/dialogs.scss", "common/styles/main.scss"],
                "scripts": ["node_modules/marked/marked.min.js"],
                "stylePreprocessorOptions": {
                    "includePaths": [
                        "node_modules/",
                        "common/styles/common",
                        "common/styles",
                        "libs",
                        "libs/nx-components"
                    ]
                },
                "vendorChunk": true,
                "extractLicenses": false,
                "sourceMap": {
                    "scripts": true,
                    "styles": false,
                    "vendor": false
                },
                "aot": true,
                "optimization": false,
                "namedChunks": true
            },
            "configurations": {
                "dev": {
                    "tsConfig": "apps/front-end/tsconfig.dev.json",
                    "fileReplacements": [
                        {
                            "replace": "common/environments/environment.ts",
                            "with": "common/environments/environment.dev.ts"
                        }
                    ],
                    "customWebpackConfig": {
                        "path": "webpack.config.js"
                    }
                },
                "zoneless": {
                    "tsConfig": "apps/front-end/tsconfig.dev.json",
                    "fileReplacements": [
                        {
                            "replace": "common/environments/environment.ts",
                            "with": "common/environments/environment.dev.ts"
                        },
                        {
                            "replace": "common/bootstrap/zone.ts",
                            "with": "common/bootstrap/zoneless.ts"
                        }
                    ]
                },
                "local": {
                    "tsConfig": "apps/front-end/tsconfig.dev.json",
                    "fileReplacements": [
                        {
                            "replace": "common/environments/environment.ts",
                            "with": "common/environments/environment.local.ts"
                        }
                    ]
                },
                "production": {
                    "tsConfig": "apps/front-end/tsconfig.prod.json",
                    "fileReplacements": [
                        {
                            "replace": "common/environments/environment.ts",
                            "with": "common/environments/environment.prod.ts"
                        }
                    ],
                    "customWebpackConfig": {
                        "path": "webpack.config.js"
                    },
                    "deployUrl": "static/",
                    "optimization": {
                        "scripts": false,
                        "styles": {
                            "minify": false,
                            "inlineCritical": false
                        }
                    },
                    "outputHashing": "all",
                    "sourceMap": false,
                    "extractLicenses": true,
                    "vendorChunk": true,
                    "buildOptimizer": false,
                    "commonChunk": true,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "2mb",
                            "maximumError": "4mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "200kb",
                            "maximumError": "355kb"
                        },
                        {
                            "type": "anyScript",
                            "maximumWarning": "1mb",
                            "maximumError": "4mb"
                        }
                    ],
                    "serviceWorker": true,
                    "ngswConfigPath": "ngsw-config.json"
                }
            },
            "defaultConfiguration": ""
        },
        "lint": {},
        "serve": {
            "executor": "@nx/angular:dev-server",
            "options": {
                "publicHost": "localhost:9000",
                "host": "0.0.0.0",
                "port": 9000,
                "sslKey": "ssl_keys/server.key",
                "sslCert": "ssl_keys/server.crt",
                "ssl": true,
                "buildTarget": "front-end:build"
            },
            "configurations": {
                "development": {
                    "buildTarget": "front-end:build:dev"
                },
                "zoneless": {
                    "buildTarget": "front-end:build:zoneless"
                },
                "production": {
                    "buildTarget": "front-end:build:production"
                }
            },
            "defaultConfiguration": "development"
        },
        "extract-i18n": {
            "executor": "@angular-devkit/build-angular:extract-i18n",
            "options": {
                "buildTarget": "front-end:build"
            }
        },
        "test": {}
    }
}
