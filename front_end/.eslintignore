# don't ever lint node_modules
node_modules

# don't lint build output (make sure it's set to your correct build folder name)
dist

# don't lint nyc coverage output
coverage

# Don't lint the auto generated static language types file
app/language_i18n_static_types.ts

# Don't lint tsconfig
tsconfig.json

# Don't lint deprecated files/folders
*.bak.*
**/*.bak/**/*
