{
  "compilerOptions": {
    "target": "es5",
    "lib": ["es2015", "es2016", "es2017", "dom", "es2018.promise"],
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "removeComments": true,
    "noImplicitAny": false,
    "suppressImplicitAnyIndexErrors": true,
    "baseUrl": "app",
    "paths": {
      "@components/*": ["src/components/*"],
      "@directives/*": ["src/directives/*"],
      "@dialogs/*": ["src/dialogs/*"],
      "@environments/*": ["environments/*"],
      "@pages/*": ["src/pages/*"],
      "@guards/*": ["src/routeGuards/*"],
      "@services/*": ["src/services/*"],
      "@src/*": ["src/*"]
    },
    "typeRoots": [
      "node_modules/@types"
    ],
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "app/main.ts",
    "app/polyfills.ts"
],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "ipvd",
    "health_monitor"
  ]
}
