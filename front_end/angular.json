{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "front-end": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "app",
      "prefix": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "allowedCommonJsDependencies": [
              "md5",
              "uuid",
              "ng2-trim-directive",
              "qrcode",
              "@firebase/util",
              "@firebase/component",
              "dateformat",
              "@videojs/xhr",
              "videojs-vtt.js",
              "global/document",
              "mux.js/lib/mp4/probe",
              "mux.js/lib/tools/ts-inspector.js",
              "swagger-ui"
            ],
            "outputPath": "dist",
            "index": "app/index.html",
            "main": "app/main.ts",
            "polyfills": "app/polyfills.ts",
            "tsConfig": "tsconfig.json",
            "assets": [
              { "glob": "**/*", "input": "node_modules/tinymce", "output": "/tinymce/" },
              "app/customization",
              "app/images",
              "app/fonts",
              "app/styles",
              "app/views",
              "app/scripts",
              "app/503.html",
              "app/downloads.json",
              "app/apple-app-site-association",
              "app/language_compiled.json",
              "app/language_i18n_static.json",
              "app/language_i18n.json",
              "app/language.json",
              "app/languages.json",
              "app/supported_languages.json",
              "app/robots.txt"
            ],
            "styles": [
              "app/src/dialogs/dialogs.scss",
              "app/styles/main.scss"
            ],
            "scripts": [
              "node_modules/marked/marked.min.js"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "app/src/styles",
                "app/styles"
              ]
            },
            "vendorChunk": true,
            "extractLicenses": false,
            "sourceMap": {
              "scripts": true,
              "styles": false,
              "vendor": false
            },
            "optimization": false,
            "namedChunks": true
          },
          "configurations": {
            "cloud-test": {
              "fileReplacements": [
                {
                  "replace": "app/environments/environment.ts",
                  "with": "app/environments/environment.cloud-test.ts"
                }
              ]
            },
            "dev2": {
              "fileReplacements": [
                {
                  "replace": "app/environments/environment.ts",
                  "with": "app/environments/environment.dev2.ts"
                }
              ]
            },
            "dev3": {
              "fileReplacements": [
                {
                  "replace": "app/environments/environment.ts",
                  "with": "app/environments/environment.dev3.ts"
                }
              ]
            },
            "local": {
              "fileReplacements": [
                {
                  "replace": "app/environments/environment.ts",
                  "with": "app/environments/environment.local.ts"
                }
              ]
            },
            "production": {
              "fileReplacements": [
                {
                  "replace": "app/environments/environment.ts",
                  "with": "app/environments/environment.prod.ts"
                }
              ],
              "deployUrl": "static/",
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "8mb",
                  "maximumError": "10mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "200kb",
                  "maximumError": "280kb"
                }
              ],
              "serviceWorker": true,
              "ngswConfigPath": "ngsw-config.json"
            },
            "stage": {
              "fileReplacements": [
                {
                  "replace": "app/environments/environment.ts",
                  "with": "app/environments/environment.stage.ts"
                }
              ]
            },
            "webadmin": {
              "fileReplacements": [
                {
                  "replace": "app/environments/environment.ts",
                  "with": "app/environments/environment.webadmin.ts"
                },
                {
                  "replace": "app/src/services/account.service/index.ts",
                  "with": "app/src/services/account.service/index.webadmin.ts"
                },
                {
                  "replace": "app/src/routeGuards/authGuard.ts",
                  "with": "app/src/routeGuards/authGuard.webadmin.ts"
                }
              ],
              "index": {
                "input": "app/index.tagless.html",
                "output": "index.html"
              }
            },
            "webadmin-prod": {
              "fileReplacements": [
                {
                  "replace": "app/environments/environment.ts",
                  "with": "app/environments/environment.webadmin-prod.ts"
                },
                {
                  "replace": "app/src/services/account.service/index.ts",
                  "with": "app/src/services/account.service/index.webadmin.ts"
                }
              ],
              "index": {
                "input": "app/index.tagless.html",
                "output": "index.html"
              },
              "deployUrl": "static/",
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "6mb",
                  "maximumError": "8mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "150kb",
                  "maximumError": "250kb"
                }
              ]
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "publicHost": "localhost:9000",
            "host": "0.0.0.0",
            "port": 9000,
            "browserTarget": "front-end:build",
            "sslKey": "ssl_keys/server.key",
            "sslCert": "ssl_keys/server.crt",
            "ssl": true
          },
          "configurations": {
            "cloud-test": {
              "browserTarget": "front-end:build:cloud-test"
            },
            "dev2": {
              "browserTarget": "front-end:build:dev2"
            },
            "dev3": {
              "browserTarget": "front-end:build:dev3"
            },
            "local": {
              "browserTarget": "front-end:build:local"
            },
            "production": {
              "browserTarget": "front-end:build:production"
            },
            "stage": {
              "browserTarget": "front-end:build:stage"
            },
            "webadmin": {
              "port": 9001,
              "publicHost": "localhost:9001",
              "browserTarget": "front-end:build:webadmin"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "front-end:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "app/test.ts",
            "polyfills": "app/polyfills.ts",
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "assets": [
              "app/favicon.ico",
              "app/assets"
            ],
            "styles": [
              "app/src/dialogs/dialogs.scss",
              "app/styles/main.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "node_modules/",
                "app/src/styles",
                "app/styles"
              ]
            },
            "scripts": [],
            "codeCoverage": true
          }
        },
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js",
            "devServerTarget": "front-end:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "front-end:serve:production"
            }
          }
        }
      }
    },
    "authorization": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/authorization",
      "sourceRoot": "projects/authorization/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "allowedCommonJsDependencies": [
              "md5",
              "uuid"
            ],
            "outputPath": "dist/authorization",
            "index": "projects/authorization/src/index.html",
            "main": "projects/authorization/src/main.ts",
            "polyfills": "projects/authorization/src/polyfills.ts",
            "tsConfig": "projects/authorization/tsconfig.app.json",
            "assets": [
              "projects/authorization/src/favicon.ico",
              "projects/authorization/src/assets"
            ],
            "styles": [
              "app/styles/main.scss",
              "projects/authorization/src/styles.scss"
            ],
            "scripts": [],
            "vendorChunk": true,
            "extractLicenses": false,
            "buildOptimizer": false,
            "sourceMap": {
              "scripts": true,
              "styles": true,
              "vendor": false
            },
            "optimization": false,
            "namedChunks": true
          },
          "configurations": {
            "production": {
              "deployUrl": "static/authorization/",
              "fileReplacements": [
                {
                  "replace": "projects/authorization/src/environments/environment.ts",
                  "with": "projects/authorization/src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "200kb",
                  "maximumError": "280kb"
                }
              ]
            },
            "development": {
              "outputHashing": "all",
              "extractLicenses": true,
              "vendorChunk": false,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "3mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "20kb",
                  "maximumError": "28kb"
                }
              ]
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "authorization:build:development",
            "host": "0.0.0.0",
            "port": 9002,
            "sslKey": "ssl_keys/server.key",
            "sslCert": "ssl_keys/server.crt",
            "ssl": true
          },
          "configurations": {
            "production": {
              "browserTarget": "authorization:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "authorization:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/authorization/src/test.ts",
            "polyfills": "projects/authorization/src/polyfills.ts",
            "tsConfig": "projects/authorization/tsconfig.spec.json",
            "karmaConfig": "projects/authorization/karma.conf.js",
            "assets": [
              "projects/authorization/src/favicon.ico",
              "projects/authorization/src/assets"
            ],
            "styles": [
              "projects/authorization/src/styles.scss"
            ],
            "scripts": []
          }
        },
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "projects/authorization/e2e/protractor.conf.js",
            "devServerTarget": "authorization:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "authorization:serve:production"
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "a9b206ea-be72-4bd1-8b99-710455b85aea",
    "cache": {
      "enabled": true,
      "path": ".angular/cache",
      "environment": "all"
    }
  }
}
