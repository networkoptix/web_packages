              ]
            },
            "vendorChunk": true,
            "extractLicenses": false,
            "sourceMap": {
              "scripts": true,
              "styles": false,
              "vendor": false
            },
            "aot": true,
            "optimization": false,
            "namedChunks": true
          },
          "configurations": {
            "development": {
              "fileReplacements": [
                {
                  "replace": "common/environments/environment.ts",
                  "with": "common/environments/environment.webadmin.ts"
                },
                {
                  "replace": "src/app/services/account.service/index.ts",
                  "with": "src/app/services/account.service/index.webadmin.ts"
                },
                {
                  "replace": "src/app/routeGuards/authGuard.ts",
                  "with": "src/app/routeGuards/authGuard.webadmin.ts"
                }
              ]
            },
            "production": {
              "fileReplacements": [
                {
                  "replace": "common/environments/environment.ts",
                  "with": "common/environments/environment.webadmin-prod.ts"
                },
                {
                  "replace": "src/app/services/account.service/index.ts",
                  "with": "src/app/services/account.service/index.webadmin.ts"
                }
              ],
              "deployUrl": "static/",
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "3mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "200kb",
                  "maximumError": "280kb"
                },
                {
                  "type": "anyScript",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                }
              ]
            }
          },
          "defaultConfiguration": ""
        },
        "lint": {
          "builder": "@nrwl/linter:eslint",
          "options": {
            "eslintConfig": ".eslintrc.js",
            "lintFilePatterns": [
              "**/*.ts",
              "**/*.component.html"
            ]
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "publicHost": "localhost:9000",
            "host": "0.0.0.0",
            "port": 9000,
            "browserTarget": "front-end:build",
            "sslKey": "ssl_keys/server.key",
            "sslCert": "ssl_keys/server.crt",
            "ssl": true
          },
          "configurations": {
            "production": {
              "browserTarget": "front-end:build:webadmin"
            }
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "common/test.ts",
            "polyfills": "apps/webadmin/src/polyfills.ts",
            "tsConfig": "tsconfig.app.json",
            "karmaConfig": "apps/webadmin/karma.conf.ci.js",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "libs/dialogs/dialogs.scss",
              "common/styles/main.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "node_modules/",
                "src/app/styles",
                "common/styles",
                "common/styles/common",
                "src/app",
                "libs"
              ]
            },
            "scripts": [],
            "codeCoverage": true
          }
        }
      }
    },
    "authorization": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "apps/authorization",
      "sourceRoot": "apps/authorization/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "allowedCommonJsDependencies": [
              "md5",
              "uuid"
            ],
            "outputPath": "dist/authorization",
            "index": "apps/authorization/src/index.html",
            "main": "apps/authorization/src/main.ts",
            "polyfills": "apps/authorization/src/polyfills.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "apps/authorization/src/favicon.ico",
              "apps/authorization/src/assets"
            ],
            "styles": [
              "src/styles/main.scss",
              "apps/authorization/src/styles.scss"
            ],
            "scripts": [],
            "vendorChunk": true,
            "extractLicenses": false,
            "buildOptimizer": false,
            "sourceMap": {
              "scripts": true,
              "styles": true,
              "vendor": false
            },
            "optimization": false,
            "namedChunks": true
          },
          "configurations": {
            "production": {
              "deployUrl": "static/authorization/",
              "fileReplacements": [
                {
                  "replace": "common/environments/environment.ts",
                  "with": "environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "3mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "200kb",
                  "maximumError": "280kb"
                },
                {
                  "type": "anyScript",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                }
              ]
            },
            "development": {
              "outputHashing": "all",
              "extractLicenses": true,
              "vendorChunk": false,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "3mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "200kb",
                  "maximumError": "280kb"
                },
                {
                  "type": "anyScript",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                }
