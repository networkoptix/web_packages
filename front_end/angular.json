              "global/document",
              "mux.js/lib/mp4/probe",
              "mux.js/lib/tools/ts-inspector.js",
              "swagger-ui"
            ],
            "outputPath": "dist",
            "index": "apps/webadmin/src/app/index.html",
            "main": "apps/webadmin/src/main.ts",
            "polyfills": "apps/webadmin/src/polyfills.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "node_modules/tinymce",
                "output": "/tinymce/"
              },
              {
                "glob": "**/*",
                "input": "common/customization",
                "output": "."
              },
              {
                "glob": "**/*",
                "input": "common/images",
                "output": "."
              },
              {
                "glob": "**/*",
                "input": "common/fonts",
                "output": "."
              },
              {
                "glob": "**/*",
                "input": "common/styles",
                "output": "."
              },
              {
                "glob": "**/*",
                "input": "common/static_assets",
                "output": "."
              },
              {
                "glob": "**/*",
                "input": "common/views",
                "output": "."
              },
              {
                "glob": "**/*",
                "input": "common/scripts",
                "output": "."
              },
              {
                "glob": "**/*",
                "input": "common/language",
                "output": "."
              },
              "src/supported_languages.json"
            ],
            "styles": [
              "libs/dialogs/dialogs.scss",
              "common/styles/main.scss"
            ],
            "scripts": [
              "node_modules/marked/marked.min.js"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "src/app/styles",
                "common/styles",
                "common/styles/common",
                "src/app",
