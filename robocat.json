{
    "jira": {
        "project_keys": [
            "CLOUD",
            "LIC"
        ]
    },
    "repo": {
        "path": "/tmp/workflow_robocat/cloud_portal",
        "url": "git@gitlab.nxvms.dev:dev/cloud_portal.git"
    },
    "enabled_rules": [
        "commit_message",
        "essential",
        "job_status",
        "workflow",
        "follow_up"
    ],
    "job_status_check_rule": {
        "open_source": {
            "approve_ruleset": {
                "relevance_checker": "is_file_open_sourced",
                "rules": [
                    {
                        "patterns": [
                            "open/.+",
                            "open_candidate/.+"
                        ],
                        "approvers": [
                            "nhartleb"
                        ]
                    }
                ]
            }
        }
    }
}
