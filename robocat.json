{
    "jira": {
        "project_keys": [
            "CLOUD",
            "INFRA",
            "LIC"
        ]
    },
    "repo": {
        "path": "/tmp/workflow_robocat/cloud_portal",
        "url": "git@gitlab.nxvms.dev:dev/cloud_portal.git"
    },
    "enabled_rules": [
        "commit_message",
        "essential",
        "job_status",
        "workflow",
        "follow_up"
    ],
    "job_status_check_rule": {
        "open_source": {
            "approve_ruleset": {
                "relevance_checker": "is_file_open_sourced",
                "rules": [
                    {
                        "patterns": [
                            "open/.+",
                            "open_candidate/.+"
                        ],
                        "approvers": [
                            "nhartleb"
                        ]
                    }
                ]
            }
        },
        "code_owner_approval": {
            "approve_ruleset": {
                "relevance_checker": "match_name_pattern",
                "rules": [
                    {
                        "patterns": [
                            "build_scripts/.+",
                            "channel_partners/.+",
                            "ci/.+",
                            "cloud/.+",
                            "deploy/.+",
                            "desktop_notifications/.+",
                            "webadmin/.+"
                        ],
                        "approvers": [
                            "nhartleb",
                            "rbarsegian"
                        ]
                    },
                    {
                        "patterns": [
                            "front_end/.+"
                        ],
                        "approvers": [
                            "awu",
                            "czach",
                            "nhartleb",
                            "rbarsegian",
                            "ttsolov"
                        ]
                    },
                    {
                        "patterns": [
                            "ft/.+"
                        ],
                        "approvers": [
                            "azosimov",
                            "gsovetov",
                            "visimetov",
                            "vshebanov"
                        ]
                    }
                ]
            }
        }
    }
}
