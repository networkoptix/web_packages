  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lib/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/networkoptix/nx_open_integrations",
    "directory": "open/packages/webrtc-stream-manager"
  },
  "homepage": "https://github.com/networkoptix/nx_open_integrations/tree/master/open/packages/webrtc-stream-manager",
  "bugs": {
    "url": "https://github.com/networkoptix/nx_open_integrations/issues"
  },
  "keywords": ["networkoptix", "nx-meta", "webrtc", "streaming", "vms", "video"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --outDir dist/lib --declarationDir dist/types",
    "ci:check": "echo 'Additional CI checks can be added here'"
  },
  "dependencies": {
    "rxjs": "7.8.1",
    "webrtc-issue-detector": "1.10.0"
  }
