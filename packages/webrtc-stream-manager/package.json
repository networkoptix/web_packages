{
  "name": "@networkoptix/webrtc-stream-manager",
  "version": "0.1.29",
  "description": "WebRTC stream manager for Nx Meta VMS cameras",
  "author": "Network Optix",
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "dist/lib/index.js",
